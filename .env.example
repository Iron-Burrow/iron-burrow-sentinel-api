# Iron Burrow Sentinel — Web environment variables

# --- Account features (/api-keys, /usage, /status) ---
# Serverless Postgres connection string (Vercel Postgres or Neon). Use the
# POOLED connection string. Tables are created automatically on first use.
# The same value works for local development.
DATABASE_URL=

# Secret used to HMAC-hash API keys before storing them. Set a long random
# value in production.
API_KEY_HASH_SECRET=dev-sentinel-api-key-hash-secret-change-me

# --- Chat assistant (optional) ---
# Enables the Sentinel chat assistant (POST /api/chat). Without it, chat returns 503.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Upstream data (optional) ---
# Iron Burrow public API (asset list, detail, price series, resolve).
IRON_BURROW_BASE_URL=https://api.ironburrow.com
